{
  "name": "aio-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "packages/components/*",
    "packages/modules/*",
    "examples/*"
  ],
  "scripts": {
    "dev": "npm --workspace @aio-ui/example-gallery run dev",
    "build": "npm --workspace @aio-ui/example-gallery run build",
    "preview": "npm --workspace @aio-ui/example-gallery run preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "~6.0.2",
    "vitest": "^4.1.12"
  }
}
