{
  "name": "aio-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "packages/components/*",
    "packages/modules/*",
    "packages/themes/*",
    "examples/*"
  ],
  "scripts": {
    "dev": "npm --workspace @aio-ui/example-gallery run dev",
    "dev:demo": "npm --workspace @aio-ui/example-demo run dev",
    "build": "npm --workspace @aio-ui/example-gallery run build",
    "build:demo": "npm --workspace @aio-ui/example-demo run build",
    "preview": "npm --workspace @aio-ui/example-gallery run preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:bounds": "node scripts/bounds.mjs",
    "new:component": "node scripts/new-component.mjs",
    "verify": "npm run typecheck && npm run check:bounds && npm test && npm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "happy-dom": "^21.0.4",
    "typescript": "~6.0.2",
    "vitest": "^4.1.12"
  }
}
