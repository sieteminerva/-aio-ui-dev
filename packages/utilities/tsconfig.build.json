{
  // Build config for the published artifact: JS + declarations into `dist/`, mirroring
  // `src/` file-for-file. Mirroring is not cosmetic — every `exports` subpath points at one
  // file, so a bundler that renamed or flattened anything would break
  // `@aio-ui/<pkg>/<Subpath>` imports for consumers.
  //
  // `tsc` and not tsup/rollup on purpose: they bundle per entry, while this repo needs a
  // 1:1 file→file mapping *and* declarations. TypeScript emits both in one pass, with no
  // extra dependency.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": false,
    // Incompatible with emitting: the flag only exists for `noEmit`/`emitDeclarationOnly`.
    "allowImportingTsExtensions": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    // Only the package's own sources; tests are not part of the artifact.
    "types": []
  },
  "include": ["src"],
  "exclude": ["src/__tests__"]
}
