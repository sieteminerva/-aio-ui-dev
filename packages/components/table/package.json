{
  "name": "@aio-ui/table",
  "version": "0.0.0",
  "type": "module",
  "files": [
    "dist",
    "*.ts",
    "*.css",
    "adapters"
  ],
  "exports": {
    ".": {
      "development": "./Table.ts",
      "types": "./dist/Table.d.ts",
      "default": "./dist/Table.js"
    },
    "./Table": {
      "development": "./Table.ts",
      "types": "./dist/Table.d.ts",
      "default": "./dist/Table.js"
    },
    "./Table.css": "./Table.css",
    "./adapters/FormAdapter": {
      "development": "./adapters/FormAdapter.ts",
      "types": "./dist/adapters/FormAdapter.d.ts",
      "default": "./dist/adapters/FormAdapter.js"
    }
  },
  "peerDependencies": {
    "@aio-ui/base": "*",
    "@aio-ui/core": "*",
    "@aio-ui/form": "*",
    "@aio-ui/module-loader": "*",
    "@aio-ui/utilities": "*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build"
  }
}
