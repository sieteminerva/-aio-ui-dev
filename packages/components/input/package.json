{
  "name": "@aio-ui/input",
  "version": "0.2.0",
  "type": "module",
  "files": [
    "dist",
    "*.ts",
    "*.css",
    "Dropdown",
    "FileUploader",
    "InputControls"
  ],
  "exports": {
    ".": {
      "development": "./index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./InputRegistry": {
      "development": "./InputRegistry.ts",
      "types": "./dist/InputRegistry.d.ts",
      "default": "./dist/InputRegistry.js"
    },
    "./InputModuleTypes": {
      "development": "./InputModuleTypes.ts",
      "types": "./dist/InputModuleTypes.d.ts",
      "default": "./dist/InputModuleTypes.js"
    },
    "./FieldTypes": {
      "development": "./FieldTypes.ts",
      "types": "./dist/FieldTypes.d.ts",
      "default": "./dist/FieldTypes.js"
    },
    "./Attribute": {
      "development": "./Attribute.ts",
      "types": "./dist/Attribute.d.ts",
      "default": "./dist/Attribute.js"
    },
    "./FormValues": {
      "development": "./FormValues.ts",
      "types": "./dist/FormValues.d.ts",
      "default": "./dist/FormValues.js"
    },
    "./CalculationTypes": {
      "development": "./CalculationTypes.ts",
      "types": "./dist/CalculationTypes.d.ts",
      "default": "./dist/CalculationTypes.js"
    },
    "./dropdown": {
      "development": "./Dropdown/Dropdown.ts",
      "types": "./dist/Dropdown/Dropdown.d.ts",
      "default": "./dist/Dropdown/Dropdown.js"
    },
    "./dropdown.css": "./Dropdown/Dropdown.css",
    "./file-uploader": {
      "development": "./FileUploader/FileUploader.ts",
      "types": "./dist/FileUploader/FileUploader.d.ts",
      "default": "./dist/FileUploader/FileUploader.js"
    },
    "./file-uploader.css": "./FileUploader/FileUploader.css",
    "./controls": {
      "development": "./InputControls/InputControls.ts",
      "types": "./dist/InputControls/InputControls.d.ts",
      "default": "./dist/InputControls/InputControls.js"
    },
    "./controls.css": "./InputControls/inputControls.css",
    "./dropdown/module": {
      "development": "./Dropdown/Dropdown.InputModule.ts",
      "types": "./dist/Dropdown/Dropdown.InputModule.d.ts",
      "default": "./dist/Dropdown/Dropdown.InputModule.js"
    },
    "./file-uploader/module": {
      "development": "./FileUploader/FileUploader.InputModule.ts",
      "types": "./dist/FileUploader/FileUploader.InputModule.d.ts",
      "default": "./dist/FileUploader/FileUploader.InputModule.js"
    },
    "./controls/module": {
      "development": "./InputControls/InputControls.InputModule.ts",
      "types": "./dist/InputControls/InputControls.InputModule.d.ts",
      "default": "./dist/InputControls/InputControls.InputModule.js"
    },
    "./popover/module": {
      "development": "./Popover.InputModule.ts",
      "types": "./dist/Popover.InputModule.d.ts",
      "default": "./dist/Popover.InputModule.js"
    },
    "./input.css": "./input.css"
  },
  "peerDependencies": {
    "@aio-ui/base": "^0.2.0",
    "@aio-ui/core": "^0.2.0",
    "@aio-ui/module-loader": "^0.2.0",
    "@aio-ui/utilities": "^0.2.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build"
  }
}
