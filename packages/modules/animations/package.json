{
  "name": "@aio-ui/animations",
  "version": "0.1.0",
  "type": "module",
  "files": [
    "dist",
    "*.ts",
    "behaviours",
    "canvas"
  ],
  "peerDependencies": {
    "@aio-ui/core": "^0.1.0",
    "@aio-ui/utilities": "^0.1.0"
  },
  "exports": {
    ".": {
      "development": "./index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./Animations.css": "./Animations.css",
    "./behaviours": {
      "development": "./behaviours/registry.ts",
      "types": "./dist/behaviours/registry.d.ts",
      "default": "./dist/behaviours/registry.js"
    },
    "./behaviours/*": {
      "development": "./behaviours/*.ts",
      "types": "./dist/behaviours/*.d.ts",
      "default": "./dist/behaviours/*.js"
    },
    "./canvas/*": {
      "development": "./canvas/*.ts",
      "types": "./dist/canvas/*.d.ts",
      "default": "./dist/canvas/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build"
  }
}
