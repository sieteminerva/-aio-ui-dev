{
  "name": "@aio-ui/theme",
  "version": "0.1.0",
  "type": "module",
  "files": [
    "dist",
    "src"
  ],
  "peerDependencies": {
    "@aio-ui/core": "^0.1.0"
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ThemeRegistry": {
      "development": "./src/ThemeRegistry.ts",
      "types": "./dist/ThemeRegistry.d.ts",
      "default": "./dist/ThemeRegistry.js"
    },
    "./ThemeRenderer": {
      "development": "./src/ThemeRenderer.ts",
      "types": "./dist/ThemeRenderer.d.ts",
      "default": "./dist/ThemeRenderer.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build"
  }
}
