{
  "name": "@aio-ui/module-loader",
  "version": "0.1.0",
  "type": "module",
  "files": [
    "dist",
    "*.ts"
  ],
  "peerDependencies": {
    "@aio-ui/core": "^0.1.0"
  },
  "exports": {
    "./ModuleRegistry": {
      "development": "./ModuleRegistry.ts",
      "types": "./dist/ModuleRegistry.d.ts",
      "default": "./dist/ModuleRegistry.js"
    },
    "./ModuleLoader": {
