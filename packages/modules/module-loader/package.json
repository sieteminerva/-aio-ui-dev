      "types": "./dist/ModuleLoader.d.ts",
      "default": "./dist/ModuleLoader.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build"
  }
}
